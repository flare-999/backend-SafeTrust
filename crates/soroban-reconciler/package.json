{
  "name": "soroban-reconciler",
  "version": "0.1.0",
  "description": "Rust-native Soroban RPC escrow state reconciler exposed to Node.js via Neon.",
  "main": "native/index.node",
  "scripts": {
    "build": "node init && neon build --release",
    "build:debug": "node init && neon build",
    "postbuild": "node ../scripts/copy-native.js --crate=soroban-reconciler"
  },
  "devDependencies": {
    "neon-cli": "^0.10.1"
  }
}
